# Local development only. Generate your own value; never commit the real .env.
# Remote lab connection template for reviewers: .env.lab.example (docs/teacher-setup.md).
ALLSAFE_ENVIRONMENT=development
ALLSAFE_BOOTSTRAP_ADMIN_TOKEN=
ALLSAFE_DATABASE_URL=sqlite:///./data/allsafe.db
ALLSAFE_INITIALIZE_SCHEMA=true
ALLSAFE_HEARTBEAT_TIMEOUT_SECONDS=120
ALLSAFE_AUTHENTICATION_MODE=local
ALLSAFE_INITIAL_ADMIN_EMAIL=admin@allsafe.local
ALLSAFE_INITIAL_ADMIN_PASSWORD=
ALLSAFE_USER_SESSION_TTL_SECONDS=28800
# Yalniz loopback gelistirme: panel parolasiz ilk yonetici olarak acilir.
# Parola bos birakilirsa ilk yonetici yalniz bu yolla girilebilir. compose.yaml'da varsayilan acik.
ALLSAFE_DEV_AUTO_LOGIN=false
ALLSAFE_COOKIE_SECURE=false
ALLSAFE_FRONTEND_URL=http://127.0.0.1:5173
ALLSAFE_API_URL=http://127.0.0.1:8000
# PhishCatch service-to-service connection. setup-phishcatch.ps1 creates the local key.
ALLSAFE_PHISHCATCH_URL=
ALLSAFE_PHISHCATCH_INTEGRATION_KEY=
ALLSAFE_PHISHCATCH_ALLOW_LOOPBACK_HTTP=false
ALLSAFE_PHISHCATCH_TIMEOUT_SECONDS=45
# Wazuh Server and Indexer use separate accounts. Never disable TLS verification.
ALLSAFE_WAZUH_SERVER_URL=
ALLSAFE_WAZUH_SERVER_USERNAME=
ALLSAFE_WAZUH_SERVER_PASSWORD=
ALLSAFE_WAZUH_SERVER_CA_FILE=
ALLSAFE_WAZUH_INDEXER_URL=
ALLSAFE_WAZUH_INDEXER_USERNAME=
ALLSAFE_WAZUH_INDEXER_PASSWORD=
ALLSAFE_WAZUH_INDEXER_CA_FILE=
ALLSAFE_WAZUH_ALERT_INDEX=wazuh-alerts-*
ALLSAFE_WAZUH_TIMEOUT_SECONDS=5
ALLSAFE_WAZUH_ALLOW_LOOPBACK_HTTP=false
# Server-local managed SSH/RDP targets. Keep real JSON, private keys and known_hosts outside Git.
ALLSAFE_MANAGED_ACCESS_CONFIG_FILE=
# Optional OpenID Connect settings; configure all fields before choosing oidc mode.
ALLSAFE_SESSION_SIGNING_SECRET=
ALLSAFE_OIDC_SERVER_METADATA_URL=
ALLSAFE_OIDC_CLIENT_ID=
ALLSAFE_OIDC_CLIENT_SECRET=
ALLSAFE_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
