# Local development only. Generate your own value; never commit the real .env.
ALLSAFE_ENVIRONMENT=development
ALLSAFE_BOOTSTRAP_ADMIN_TOKEN=
ALLSAFE_DATABASE_URL=sqlite:///./data/allsafe.db
ALLSAFE_INITIALIZE_SCHEMA=true
ALLSAFE_HEARTBEAT_TIMEOUT_SECONDS=120
ALLSAFE_AUTHENTICATION_MODE=local
ALLSAFE_INITIAL_ADMIN_EMAIL=admin@allsafe.local
ALLSAFE_INITIAL_ADMIN_PASSWORD=
ALLSAFE_USER_SESSION_TTL_SECONDS=28800
ALLSAFE_COOKIE_SECURE=false
ALLSAFE_FRONTEND_URL=http://127.0.0.1:5173
ALLSAFE_API_URL=http://127.0.0.1:8000
# Optional OpenID Connect settings; configure all fields before choosing oidc mode.
ALLSAFE_SESSION_SIGNING_SECRET=
ALLSAFE_OIDC_SERVER_METADATA_URL=
ALLSAFE_OIDC_CLIENT_ID=
ALLSAFE_OIDC_CLIENT_SECRET=
ALLSAFE_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
