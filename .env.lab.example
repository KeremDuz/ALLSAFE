# ALLSAFE laboratuvar bağlantısı (hocalar / ekip üyeleri için şablon).
# Bu dosya gizli bilgi içermez. Proje ekibinin özel olarak gönderdiği dolu dosyayı
# proje kökünde ".env" adıyla kaydedin; .env Git'e alınmaz. Ayrıntı: docs/teacher-setup.md
#
# Sunucu adresleri yalnız Tailscale ağı (tailnet) içinden erişilebilir.

# Panel parolasız, yalnız bu bilgisayardan (127.0.0.1) ilk yönetici olarak açılır.
ALLSAFE_DEV_AUTO_LOGIN=true

# PhishCatch QR/URL analizi (sunucudan sunucuya entegrasyon kapısı)
ALLSAFE_PHISHCATCH_URL=https://keremserver.tailf2e48d.ts.net:10443
ALLSAFE_PHISHCATCH_INTEGRATION_KEY=

# Wazuh: ayrı, salt okunur Server API ve Indexer hesapları
ALLSAFE_WAZUH_SERVER_URL=https://keremserver.tailf2e48d.ts.net:55000
ALLSAFE_WAZUH_SERVER_USERNAME=allsafe-reader
ALLSAFE_WAZUH_SERVER_PASSWORD=
ALLSAFE_WAZUH_INDEXER_URL=https://keremserver.tailf2e48d.ts.net:9200
ALLSAFE_WAZUH_INDEXER_USERNAME=allsafe-reader
ALLSAFE_WAZUH_INDEXER_PASSWORD=
